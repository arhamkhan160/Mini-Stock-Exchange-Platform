# Copy to .env before running the stack:   cp .env.example .env
# Dev-only values. Everything here is safe for a local course demo, nothing
# more. JWT_SECRET and INTERNAL_API_KEY must be IDENTICAL across all containers
# or every request 401s with no useful message.

COMPOSE_PROJECT_NAME=mse

# ---------- auth ----------
JWT_SECRET=super-secret-change-me-in-production-0f3a9c
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
INTERNAL_API_KEY=internal-dev-key-7c1b

# ---------- logging ----------
LOG_LEVEL=INFO

# ---------- postgres ----------
POSTGRES_USER=mse
POSTGRES_PASSWORD=mse_pw
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_pw

# ---------- rabbitmq ----------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ---------- redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- frontend (inlined at BUILD time, passed as docker build args) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
